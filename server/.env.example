# Server Configuration
PORT=8765

# Directory where prompt markdown files are stored
PROMPTS_DIR=./server

# Root directory for file inclusion (@path syntax)
# This is the base directory that file paths will be resolved from
FILES_ROOT=./server

# Directory where generated images are saved
IMAGES_DIR=./images

# If true, disable SSE streaming and return single JSON responses
NO_STREAM=false

# If true, enable server debug logging and raw response.event passthrough
DEBUG=false

# JSONL file for debug events (used when DEBUG=true)
DEBUG_LOG_FILE=./logs/server-debug.jsonl

# Request timeout in seconds (applies to both server and orchestrator)
# Default: 360 (6 minutes)
REQUEST_TIMEOUT=360
